# Application
APP_NAME=TaxPilot AI
APP_ENV=development
SECRET_KEY=taxpilot-super-secret-jwt-key-2024-enterprise-grade-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for beginner-friendly local development & demonstration)
DATABASE_URL=sqlite+aiosqlite:///./taxpilot.db
SYNC_DATABASE_URL=sqlite:///./taxpilot.db
# For PostgreSQL Production:
# DATABASE_URL=postgresql+asyncpg://taxpilot:taxpilot_pass@localhost:5432/taxpilot_db
# SYNC_DATABASE_URL=postgresql+psycopg2://taxpilot:taxpilot_pass@localhost:5432/taxpilot_db

# Gemini AI (Auto-activates built-in deterministic Mock Adapter if key is placeholder or unset)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=8192

# Langfuse (optional — set USE_LANGFUSE=false to disable)
USE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# MCP Servers
TAX_PORTAL_MCP_HOST=localhost
TAX_PORTAL_MCP_PORT=8001
LEDGER_MCP_HOST=localhost
LEDGER_MCP_PORT=8002

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000,*

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
